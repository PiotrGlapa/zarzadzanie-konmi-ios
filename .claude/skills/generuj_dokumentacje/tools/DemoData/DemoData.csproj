<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs demo-data.sql against the database created by tools/ZarzadzanieKonmi.Seed (skill generuj_dokumentacje). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <None Include="demo-data.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
