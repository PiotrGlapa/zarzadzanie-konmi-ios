{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zarzadzanie-konmi.local/schemas/export-1.6.json",
  "title": "Horsely — eksport danych",
  "description": "Schemat pliku eksportu w wersji 1.6 (akceptuje także pliki 1.0, 1.1, 1.2, 1.3, 1.4 i 1.5) (SPECYFIKACJA.md sekcja 8.1). Pola rekordów odpowiadają modelowi (camelCase). Kwoty w PLN jako liczby. Rekordy w koszu nie są eksportowane. Dodatkowe pola dopuszczalne w wersjach MINOR (additionalProperties nie jest zamknięte dla rekordów). Od 1.2: pola zakupu, sprzedaży i wartości konia, kolekcja trainings i typ słownika TrainingType. Od 1.3: typ kontaktu Trainer oraz trener i koszt treningu (trainerContactId, cost, originalAmount, originalCurrency). Od 1.4: typ kontaktu Rider oraz riderContactId w treningu i starcie w zawodach (zastępuje tekstowe pole rider). Od 1.5: status konia Injured (Kontuzjowany); w scope opcjonalne updatedSince, fullRequired i nextUpdatedSince (eksport przyrostowy przez API); na najwyższym poziomie opcjonalne tablice trashed (rekordy przeniesione do kosza od updatedSince) i purged (rekordy trwale usunięte od updatedSince). Eksport z programu nie zawiera updatedSince, trashed ani purged; import odrzuca plik z scope.updatedSince. Od 1.6 (tylko eksport serwera przez /api/v3): załączniki treningu (ownerType Training), w każdym załączniku capturedAt, latitude i longitude (null, gdy brak); eksport pełny dodatkowo zawiera trainingRecordings (nagrania jazd z odcinkami chodów i trackData w base64), horseRideProfiles (profile jazdy koni) i rideDefaults (ustawienia domyślne jazd albo null). Eksport przyrostowy nie zawiera tych trzech kolekcji.",
  "type": "object",
  "required": [
    "schemaVersion",
    "exportedAt",
    "appVersion",
    "scope",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "appVersion": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": [
        "type",
        "includesAttachmentFiles"
      ],
      "properties": {
        "type": {
          "enum": [
            "full",
            "horse"
          ]
        },
        "horseId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "includesAttachmentFiles": {
          "type": "boolean"
        },
        "updatedSince": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Chwila graniczna eksportu przyrostowego (włącznie); brak lub null = eksport pełny."
        },
        "fullRequired": {
          "type": "boolean",
          "default": false,
          "description": "true: updatedSince jest wcześniejsze niż linia bazowa synchronizacji — data zawiera pełny eksport, a klient zastępuje całą lokalną kopię (brak trashed i purged)."
        },
        "nextUpdatedSince": {
          "type": "string",
          "format": "date-time",
          "description": "Wartość updatedSince do następnego żądania przyrostowego (chwila odczytu minus 60 s)."
        }
      },
      "if": {
        "properties": {
          "type": {
            "const": "horse"
          }
        }
      },
      "then": {
        "required": [
          "horseId"
        ],
        "properties": {
          "horseId": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "required": [
        "dictionaries",
        "contacts",
        "horses",
        "vetVisits",
        "farrierVisits",
        "physioVisits",
        "specialistVisits",
        "competitions",
        "purchases",
        "notes",
        "reminders",
        "attachments"
      ],
      "properties": {
        "dictionaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dictionaryItem"
          }
        },
        "contacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contact"
          }
        },
        "horses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/horse"
          }
        },
        "vetVisits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vetVisit"
          }
        },
        "farrierVisits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/farrierVisit"
          }
        },
        "physioVisits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/physioVisit"
          }
        },
        "specialistVisits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/specialistVisit"
          }
        },
        "competitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/competition"
          }
        },
        "purchases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/purchase"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          }
        },
        "reminders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reminder"
          }
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attachment"
          }
        },
        "trainings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/training"
          },
          "description": "Od 1.2; brak w pliku 1.0 i 1.1 = pusta lista."
        },
        "trainingRecordings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trainingRecording"
          },
          "description": "Od 1.6, tylko eksport pełny; brak = pusta lista."
        },
        "horseRideProfiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/horseRideProfile"
          },
          "description": "Od 1.6, tylko eksport pełny; brak = pusta lista."
        },
        "rideDefaults": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/rideDefaults"
            }
          ],
          "description": "Od 1.6, tylko eksport pełny; null lub brak = serwer nie ma zapisanych ustawień."
        }
      },
      "additionalProperties": true
    },
    "trashed": {
      "type": "array",
      "description": "Tylko odpowiedź przyrostowa: rekordy przeniesione do kosza od updatedSince (nie występują w data).",
      "items": {
        "type": "object",
        "required": [
          "type",
          "id",
          "deletedAt",
          "batchId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Horse",
              "VetVisit",
              "FarrierVisit",
              "PhysioVisit",
              "SpecialistVisit",
              "Competition",
              "CompetitionStart",
              "Purchase",
              "Note",
              "Training",
              "Reminder",
              "Contact",
              "DictionaryItem",
              "Attachment"
            ]
          },
          "id": {
            "$ref": "#/$defs/uuid"
          },
          "deletedAt": {
            "type": "string",
            "format": "date-time"
          },
          "batchId": {
            "$ref": "#/$defs/uuid"
          }
        },
        "additionalProperties": false
      }
    },
    "purged": {
      "type": "array",
      "description": "Tylko odpowiedź przyrostowa: rekordy trwale usunięte od updatedSince.",
      "items": {
        "type": "object",
        "required": [
          "type",
          "id",
          "purgedAt"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Horse",
              "VetVisit",
              "FarrierVisit",
              "PhysioVisit",
              "SpecialistVisit",
              "Competition",
              "CompetitionStart",
              "Purchase",
              "Note",
              "Training",
              "Reminder",
              "Contact",
              "DictionaryItem",
              "Attachment"
            ]
          },
          "id": {
            "$ref": "#/$defs/uuid"
          },
          "purgedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "description": "Plik zadeklarowany jako 1.4, 1.5 lub 1.6 nie ma tekstowego pola rider w treningach i startach (zastępuje je riderContactId); pliki 1.0–1.3 z rider są nadal przyjmowane — import pomija to pole.",
      "if": {
        "properties": {
          "schemaVersion": {
            "enum": [
              "1.4",
              "1.5",
              "1.6"
            ]
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "trainings": {
                "items": {
                  "not": {
                    "required": [
                      "rider"
                    ]
                  }
                }
              },
              "competitions": {
                "items": {
                  "properties": {
                    "starts": {
                      "items": {
                        "not": {
                          "required": [
                            "rider"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "uuidOrNull": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "dateOrNull": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "money": {
      "type": "number",
      "minimum": 0,
      "multipleOf": 0.01
    },
    "moneyOrNull": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "multipleOf": 0.01
    },
    "textOrNull": {
      "type": [
        "string",
        "null"
      ]
    },
    "audit": {
      "type": "object",
      "required": [
        "id",
        "createdAt",
        "updatedAt",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "foreignAmount": {
      "type": "object",
      "properties": {
        "originalAmount": {
          "type": [
            "number",
            "null"
          ]
        },
        "originalCurrency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "dictionaryItem": {
      "allOf": [
        {
          "$ref": "#/$defs/audit"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "value",
        "sortOrder",
        "isActive",
        "isSystem"
      ],
      "properties": {
        "type": {
          "enum": [
            "VetVisitType",
            "FarrierService",
            "PhysioBodyArea",
            "PhysioTechnique",
            "SpecialistType",
            "CompetitionRank",
            "CompetitionDiscipline",
            "PurchaseCategory",
            "Unit",
            "TrainingType"
          ]
        },
        "value": {
          "type": "string",
          "maxLength": 100
        },
        "sortOrder": {
          "type": "integer"
        },
        "isActive": {
          "type": "boolean"
        },
        "isSystem": {
          "type": "boolean"
        },
        "systemKey": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "contact": {
      "allOf": [
        {
          "$ref": "#/$defs/audit"
        }
      ],
      "type": "object",
      "required": [
        "name",
        "types",
        "isArchived"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "Vet",
              "Farrier",
              "Physio",
              "Specialist",
              "Shop",
              "Organizer",
              "Other",
              "Trainer",
              "Rider"
            ]
          }
        },
        "company": {
          "$ref": "#/$defs/textOrNull"
        },
        "phone": {
          "$ref": "#/$defs/textOrNull"
        },
        "email": {
          "$ref": "#/$defs/textOrNull"
        },
        "address": {
          "$ref": "#/$defs/textOrNull"
        },
        "specialization": {
          "$ref": "#/$defs/textOrNull"
        },
        "notes": {
          "$ref": "#/$defs/textOrNull"
        },
        "isArchived": {
          "type": "boolean"
        }
      }
    },
    "horse": {
      "allOf": [
        {
          "$ref": "#/$defs/audit"
        }
      ],
      "type": "object",
      "required": [
        "name",
        "status",
        "farrierIntervalWeeks",
        "birthYearOnly"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "passportNumber": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 50,
          "description": "Od 1.1 może być pusty (źrebak bez paszportu); wymagany, gdy isFoal = false."
        },
        "isFoal": {
          "type": "boolean",
          "default": false,
          "description": "Od 1.1; brak w pliku 1.0 = false."
        },
        "stableName": {
          "$ref": "#/$defs/textOrNull"
        },
        "ueln": {
          "$ref": "#/$defs/textOrNull"
        },
        "microchipNumber": {
          "$ref": "#/$defs/textOrNull"
        },
        "passportIssuer": {
          "$ref": "#/$defs/textOrNull"
        },
        "passportIssueDate": {
          "$ref": "#/$defs/dateOrNull"
        },
        "breed": {
          "$ref": "#/$defs/textOrNull"
        },
        "sex": {
          "enum": [
            "Mare",
            "Stallion",
            "Gelding",
            null
          ]
        },
        "color": {
          "$ref": "#/$defs/textOrNull"
        },
        "birthDate": {
          "$ref": "#/$defs/dateOrNull"
        },
        "birthYearOnly": {
          "type": "boolean"
        },
        "birthCountry": {
          "$ref": "#/$defs/textOrNull"
        },
        "sire": {
          "$ref": "#/$defs/textOrNull"
        },
        "dam": {
          "$ref": "#/$defs/textOrNull"
        },
        "damSire": {
          "$ref": "#/$defs/textOrNull"
        },
        "breeder": {
          "$ref": "#/$defs/textOrNull"
        },
        "owner": {
          "$ref": "#/$defs/textOrNull"
        },
        "markings": {
          "$ref": "#/$defs/textOrNull"
        },
        "photoAttachmentId": {
          "$ref": "#/$defs/uuidOrNull"
        },
        "farrierIntervalWeeks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 26
        },
        "status": {
          "enum": [
            "Active",
            "Sold",
            "Deceased",
            "Leased",
            "Injured"
          ]
        },
        "statusDate": {
          "$ref": "#/$defs/dateOrNull"
        },
        "statusNote": {
          "$ref": "#/$defs/textOrNull"
        },
        "notes": {
          "$ref": "#/$defs/textOrNull"
        },
        "purchasePrice": {
          "$ref": "#/$defs/moneyOrNull",
          "description": "Od 1.2; brak = null."
        },
        "purchaseDate": {
          "$ref": "#/$defs/dateOrNull"
        },
        "salePrice": {
          "$ref": "#/$defs/moneyOrNull"
        },
        "saleDate": {
          "$ref": "#/$defs/dateOrNull"
        },
        "estimatedValue": {
          "$ref": "#/$defs/moneyOrNull",
          "description": "Wartość konia — ocena własna właściciela."
        }
      }
    },
    "vetMedication": {
      "allOf": [
        {
          "$ref": "#/$defs/audit"
        }
      ],
      "type": "object",
      "required": [
        "name",
        "sortOrder"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "dosage": {
          "$ref": "#/$defs/textOrNull"
        },
        "startDate": {
          "$ref": "#/$defs/dateOrNull"
        },
        "endDate": {
          "$ref": "#/$defs/dateOrNull"
        },
        "administration": {
          "enum": [
            "AdministeredAtVisit",
            "Prescribed",
            null
          ]
        },
        "notes": {
          "$ref": "#/$defs/textOrNull"
        },
        "sortOrder": {
          "type": "integer"
        }
      }
    },
    "vetVisit": {
      "allOf": [
        {
          "$ref": "#/$defs/audit"
        },
        {
          "$ref": "#/$defs/foreignAmount"
        }
      ],
      "type": "object",
      "required": [
        "horseId",
        "visitDateTime",
        "visitTypeId",
        "medications"
      ],
      "properties": {
        "horseId": {
          "$ref": "#/$defs/uuid"
        },
        "visitDateTime": {
          "type": "string"
        },
        "contactId": {
          "$ref": "#/$defs/uuidOrNull"
        },
        "visitTypeId": {
          "$ref": "#/$defs/uuid"
        },
        "reason": {
          "$ref": "#/$defs/textOrNull"
        },
        "diagnosis": {
          "$ref": "#/$defs/textOrNull"
        },
        "recommendations": {
          "$ref": "#/$defs/textOrNull"
        },
        "vaccineOrProduct": {
          "$ref": "#/$defs/textOrNull"
        },
        "batchNumber": {
          "$ref": "#/$defs/textOrNull"
        },
        "cost": {
          "$ref": "#/$defs/moneyOrNull"
        },
        "nextVisitDate": {
          "$ref": "#/$defs/dateOrNull"
        },
        "nextVisitPurpose": {
          "$ref": "#/$defs/textOrNull"
        },
        "medications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vetMedication"
          }
        }
      }
    },
    "farrierVisit": {
      "allOf": [
        {
          "$ref": "#/$defs/audit"
        },
        {
          "$ref": "#/$defs/foreignAmount"
        }
      ],
      "type": "object",
      "required": [
        "horseId",
        "visitDate",
        "serviceId"
      ],
      "properties": {
        "horseId": {
          "$ref": "#/$defs/uuid"
        },
        "visitDate": {
          "$ref": "#/$defs/date"
        },
        "contactId": {
          "$ref": "#/$defs/uuidOrNull"
        },
        "serviceId": {
          "$ref": "#/$defs/uuid"
        },
        "hoofNotes": {
          "$ref": "#/$defs/textOrNull"
        },
        "cost": {
          "$ref": "#/$defs/moneyOrNull"
        },
        "nextVisitDate": {
          "$ref": "#/$defs/dateOrNull"
        }
      }
    },
    "physioVisit": {
      "allOf": [
        {
          "$ref": "#/$defs/audit"
        },
        {
          "$ref": "#/$defs/foreignAmount"
        }
      ],
      "type": "object",
      "required": [
        "horseId",
        "visitDate",
        "bodyAreaIds",
        "techniqueIds"
      ],
      "properties": {
        "horseId": {
          "$ref": "#/$defs/uuid"
        },
        "visitDate": {
          "$ref": "#/$defs/date"
        },
        "contactId": {
          "$ref": "#/$defs/uuidOrNull"
        },
        "reason": {
          "$ref": "#/$defs/textOrNull"
        },
        "bodyAreaIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "techniqueIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "observations": {
          "$ref": "#/$defs/textOrNull"
        },
        "recommendations": {
          "$ref": "#/$defs/textOrNull"
        },
        "cost": {
          "$ref": "#/$defs/moneyOrNull"
        },
        "nextVisitDate": {
          "$ref": "#/$defs/dateOrNull"
        },
        "nextVisitPurpose": {
          "$ref": "#/$defs/textOrNull"
        }
      }
    },
    "specialistVisit": {
      "allOf": [
        {
          "$ref": "#/$defs/audit"
        },
        {
          "$ref": "#/$defs/foreignAmount"
        }
      ],
      "type": "object",
      "required": [
        "horseId",
        "visitDate",
        "specialistTypeId"
      ],
      "properties": {
        "horseId": {
          "$ref": "#/$defs/uuid"
        },
        "visitDate": {
          "$ref": "#/$defs/date"
        },
        "specialistTypeId": {
          "$ref": "#/$defs/uuid"
        },
        "contactId": {
          "$ref": "#/$defs/uuidOrNull"
        },
        "reason": {
          "$ref": "#/$defs/textOrNull"
        },
        "description": {
          "$ref": "#/$defs/textOrNull"
        },
        "recommendations": {
          "$ref": "#/$defs/textOrNull"
        },
        "cost": {
          "$ref": "#/$defs/moneyOrNull"
        },
        "nextVisitDate": {
          "$ref": "#/$defs/dateOrNull"
        },
        "nextVisitPurpose": {
          "$ref": "#/$defs/textOrNull"
        }
      }
    },
    "competitionStart": {
      "allOf": [
        {
          "$ref": "#/$defs/audit"
        },
        {
          "$ref": "#/$defs/foreignAmount"
        }
      ],
      "type": "object",
      "required": [
        "horseId"
      ],
      "properties": {
        "horseId": {
          "$ref": "#/$defs/uuid"
        },
