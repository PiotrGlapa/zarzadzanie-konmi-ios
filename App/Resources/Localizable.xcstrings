    "about_compat_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój program nie zapisuje jeszcze wersji rekordów, więc telefon nie może synchronizować zmian: edycja, usuwanie i „Przełóż” są wyłączone, a dodawanie wpisów działa jak dotąd. Zaktualizuj program na komputerze do wersji z synchronizacją zmian."
          }
        }
      }
    },
