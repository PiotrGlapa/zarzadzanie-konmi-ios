    "notif_permission_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby przypominać o terminach, aplikacja musi mieć zgodę telefonu na powiadomienia. Za chwilę telefon zapyta o nią. Możesz odmówić — aplikacja będzie działać dalej, a zgodę włączysz później w ustawieniach."
          }
        }
      }
    },
