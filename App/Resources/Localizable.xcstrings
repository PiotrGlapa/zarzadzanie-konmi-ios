      "extractionState" : "manual",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgoda została odrzucona, więc powiadomienia się nie pokażą. Aby je włączyć, otwórz ustawienia powiadomień aplikacji i zezwól na nie. Reszta aplikacji działa bez zmian."
          }
        }
      }
    },
