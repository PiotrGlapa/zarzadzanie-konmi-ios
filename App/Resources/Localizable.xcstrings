    "ride_desc_climb" : {
      "extractionState" : "manual",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ile punktów doliczyć za każde 10 m podjazdu. W górach albo dla starszego konia zwiększ."
          }
        }
      }
    },
    "ride_desc_heavy" : {
      "extractionState" : "manual",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jazda z co najmniej taką liczbą punktów liczy się jako ciężka (raport: odpoczynek)."
          }
        }
      }
    },
    "ride_desc_thresholds" : {
      "extractionState" : "manual",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do jakiej prędkości koń idzie stępem / kłusem. Koń z długim krokiem kłusuje szybciej — podnieś próg; kuc — obniż. Sprawdź na nagranej jeździe, czy podział chodów zgadza się z tym, co pamiętasz."
          }
        }
      }
    },
    "ride_desc_warn" : {
      "extractionState" : "manual",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ile obciążenie ostatnich 7 dni może przekroczyć średnią tygodniową z ostatnich 4 tygodni, zanim pojawi się ostrzeżenie. Koń po kontuzji lub przerwie: 15–20%."
          }
        }
      }
    },
    "ride_desc_weight_canter" : {
      "extractionState" : "manual",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak wyżej dla galopu. Koń zimnokrwisty lub z nadwagą: 4–5; koń pełnej krwi w formie: 2–2,5."
          }
        }
      }
    },
    "ride_desc_weight_trot" : {
      "extractionState" : "manual",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ile razy minuta kłusa męczy konia bardziej niż minuta stępa. Młody lub słabo przygotowany koń: 2,5–3; koń wytrzymałościowy w formie: 1,5."
          }
        }
      }
    },
    "ride_desc_weight_walk" : {
      "extractionState" : "manual",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ile „punktów pracy” daje minuta stępa. Zostaw 1 — to punkt odniesienia."
          }
        }
      }
    },
